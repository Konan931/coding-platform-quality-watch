{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalwelfareproductions.example/schemas/finding.schema.json",
  "title": "Coding Platform Quality Watch Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "platform",
    "category",
    "title",
    "observation",
    "environment",
    "reproduction",
    "evidence",
    "confidence",
    "status",
    "firstSeen",
    "lastVerified"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+){2,}$" },
    "platform": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "content",
        "pedagogy",
        "autograder",
        "runtime",
        "sandbox",
        "ux",
        "accessibility",
        "security",
        "privacy",
        "reliability",
        "compatibility",
        "positive-pattern"
      ]
    },
    "language": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "actual"],
      "properties": {
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": ["capturedAt"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "runtime": { "type": ["string", "null"] },
        "browser": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "device": { "type": ["string", "null"] },
        "locale": { "type": ["string", "null"] }
      }
    },
    "reproduction": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "snippet": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "runtime-output",
              "reproduction-snippet",
              "screenshot",
              "source-reference",
              "platform-response",
              "manual-observation",
              "counterevidence"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["unverified", "reproduced", "confirmed", "ambiguous", "environment-specific"]
    },
    "status": {
      "type": "string",
      "enum": ["open", "monitoring", "fixed", "regression", "outdated", "unreproducible"]
    },
    "firstSeen": { "type": "string", "format": "date" },
    "lastVerified": { "type": "string", "format": "date" },
    "notes": { "type": ["string", "null"] }
  }
}
